# Nếu chạy qua Nginx Reverse Proxy (theo file nginx.conf hiện tại): dùng /api
VITE_API_BASE_URL=/api

# Nếu Frontend build tĩnh và gọi thẳng sang Backend domain không qua Nginx proxy:
# VITE_API_BASE_URL=https://wifi-haiphong-api.duckdns.org/api

